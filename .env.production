# Production configuration template — committed intentionally.
# All values here are defaults/placeholders. No secrets are stored in this file.

# =============================================================================
# Environment
# =============================================================================
MCPFOLIO_ENVIRONMENT=production

# =============================================================================
# Ollama Configuration
# =============================================================================
# Use quantized model for production efficiency
MCPFOLIO_OLLAMA_MODEL=llama3.2:3b-q8_0
MCPFOLIO_OLLAMA_HOST=http://localhost:11434
MCPFOLIO_OLLAMA_TIMEOUT=120
MCPFOLIO_OLLAMA_TEMPERATURE=0.7

# =============================================================================
# Logging Configuration
# =============================================================================
# Reduce log verbosity in production
MCPFOLIO_LOG_LEVEL=WARNING
MCPFOLIO_LOG_FILE=logs/mcpfolio-production.log
MCPFOLIO_LOG_MAX_BYTES=50000000
MCPFOLIO_LOG_BACKUP_COUNT=10
MCPFOLIO_LOG_JSON_FORMAT=true

# =============================================================================
# Performance Configuration
# =============================================================================
MCPFOLIO_MAX_CONTEXT_TOKENS=128000
MCPFOLIO_COLD_START_TIMEOUT=10

# =============================================================================
# yfinance Configuration
# =============================================================================
# More aggressive caching in production
MCPFOLIO_YFINANCE_CACHE_TTL=600
MCPFOLIO_YFINANCE_RATE_LIMIT=5
MCPFOLIO_YFINANCE_TIMEOUT=30

# =============================================================================
# Data Persistence
# =============================================================================
MCPFOLIO_DATA_DIR=data/production
MCPFOLIO_ENABLE_CACHING=true

# =============================================================================
# Security
# =============================================================================
# Set a strong API key in production
MCPFOLIO_API_KEY=

# Configure CORS if exposing API
MCPFOLIO_ENABLE_CORS=false
MCPFOLIO_ALLOWED_ORIGINS=

# Quant-Ollama-Analyst Environment Configuration Template
# Copy this file to .env and customize for your environment
# All variables are prefixed with QUANT_

# =============================================================================
# Environment
# =============================================================================
# Options: development, staging, production
QUANT_ENVIRONMENT=development

# =============================================================================
# Ollama Configuration
# =============================================================================
# Model to use (llama3.2:3b, llama3.2:1b, mistral, etc.)
QUANT_OLLAMA_MODEL=llama3.2:3b

# Ollama server URL
QUANT_OLLAMA_HOST=http://localhost:11434

# Request timeout in seconds (1-600)
QUANT_OLLAMA_TIMEOUT=120

# Temperature for LLM responses (0.0-2.0)
QUANT_OLLAMA_TEMPERATURE=0.7

# =============================================================================
# MCP Server Configuration
# =============================================================================
# Transport protocol: stdio or sse
QUANT_MCP_TRANSPORT=stdio

# Path to MCP server (leave empty for auto-detection)
QUANT_MCP_SERVER_PATH=

# =============================================================================
# yfinance Configuration
# =============================================================================
# Max requests per second (1-100)
QUANT_YFINANCE_RATE_LIMIT=5

# Request timeout in seconds (1-300)
QUANT_YFINANCE_TIMEOUT=30

# Cache TTL in seconds (0 to disable, max 3600)
QUANT_YFINANCE_CACHE_TTL=300

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
QUANT_LOG_LEVEL=INFO

# Log file path
QUANT_LOG_FILE=logs/quant-ollama.log

# Max log file size in bytes before rotation
QUANT_LOG_MAX_BYTES=10000000

# Number of backup log files to keep
QUANT_LOG_BACKUP_COUNT=5

# Use JSON format for logs (true/false)
QUANT_LOG_JSON_FORMAT=true

# =============================================================================
# Performance Configuration
# =============================================================================
# Maximum LLM context size in tokens
QUANT_MAX_CONTEXT_TOKENS=128000

# Maximum startup time in seconds
QUANT_COLD_START_TIMEOUT=5

# =============================================================================
# Data Persistence
# =============================================================================
# Directory for persistent data
QUANT_DATA_DIR=data

# Enable response caching (true/false)
QUANT_ENABLE_CACHING=true

# =============================================================================
# Security (for future API endpoints)
# =============================================================================
# API authentication key (leave empty to disable)
QUANT_API_KEY=

# Enable CORS (true/false)
QUANT_ENABLE_CORS=false

# Allowed CORS origins (comma-separated)
QUANT_ALLOWED_ORIGINS=

# MCPFolio Environment Configuration Template
# Copy this file to .env and customize for your environment
# All variables are prefixed with MCPFOLIO_

# =============================================================================
# Environment
# =============================================================================
# Options: development, staging, production
MCPFOLIO_ENVIRONMENT=development

# =============================================================================
# Ollama Configuration
# =============================================================================
# Model to use (llama3.2:3b, llama3.2:1b, mistral, etc.)
MCPFOLIO_OLLAMA_MODEL=llama3.2:3b

# Ollama server URL
MCPFOLIO_OLLAMA_HOST=http://localhost:11434

# Request timeout in seconds (1-600)
MCPFOLIO_OLLAMA_TIMEOUT=120

# Temperature for LLM responses (0.0-2.0)
MCPFOLIO_OLLAMA_TEMPERATURE=0.7

# =============================================================================
# MCP Server Configuration
# =============================================================================
# Transport protocol: stdio or sse
MCPFOLIO_MCP_TRANSPORT=stdio

# Path to MCP server (leave empty for auto-detection)
MCPFOLIO_MCP_SERVER_PATH=

# =============================================================================
# yfinance Configuration
# =============================================================================
# Max requests per second (1-100)
MCPFOLIO_YFINANCE_RATE_LIMIT=5

# Request timeout in seconds (1-300)
MCPFOLIO_YFINANCE_TIMEOUT=30

# Cache TTL in seconds (0 to disable, max 3600)
MCPFOLIO_YFINANCE_CACHE_TTL=300

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
MCPFOLIO_LOG_LEVEL=INFO

# Log file path
MCPFOLIO_LOG_FILE=logs/mcpfolio.log

# Max log file size in bytes before rotation
MCPFOLIO_LOG_MAX_BYTES=10000000

# Number of backup log files to keep
MCPFOLIO_LOG_BACKUP_COUNT=5

# Use JSON format for logs (true/false)
MCPFOLIO_LOG_JSON_FORMAT=true

# =============================================================================
# Performance Configuration
# =============================================================================
# Maximum LLM context size in tokens
MCPFOLIO_MAX_CONTEXT_TOKENS=128000

# Maximum startup time in seconds
MCPFOLIO_COLD_START_TIMEOUT=5

# =============================================================================
# Data Persistence
# =============================================================================
# Directory for persistent data
MCPFOLIO_DATA_DIR=data

# Enable response caching (true/false)
MCPFOLIO_ENABLE_CACHING=true

# =============================================================================
# Security (for future API endpoints)
# =============================================================================
# API authentication key (leave empty to disable)
MCPFOLIO_API_KEY=

# Enable CORS (true/false)
MCPFOLIO_ENABLE_CORS=false

# Allowed CORS origins (comma-separated)
MCPFOLIO_ALLOWED_ORIGINS=
